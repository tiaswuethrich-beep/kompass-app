<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/w_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="KOMPASS" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/w_text"
        android:textSize="15sp"
        android:maxLines="2"
        android:paddingTop="2dp"
        android:text="" />

    <!-- Schnell eintragen: Snus und Kaffee -->
    <LinearLayout
        android:id="@+id/w_quick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <LinearLayout
            android:id="@+id/w_snus_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Snus" android:textColor="@color/w_muted" android:textSize="11sp" />
                <TextView android:id="@+id/w_snus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/w_text" android:textSize="17sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/w_snus_minus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_off"
                android:paddingStart="9dp" android:paddingEnd="9dp"
                android:paddingTop="5dp" android:paddingBottom="5dp"
                android:text="−" android:textColor="@color/w_text" android:textStyle="bold" android:textSize="14sp" />
            <TextView
                android:id="@+id/w_snus_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_accent"
                android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="5dp" android:paddingBottom="5dp"
                android:text="+1" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_coffee_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Kaffee" android:textColor="@color/w_muted" android:textSize="11sp" />
                <TextView android:id="@+id/w_coffee" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/w_text" android:textSize="17sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/w_coffee_minus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_off"
                android:paddingStart="9dp" android:paddingEnd="9dp"
                android:paddingTop="5dp" android:paddingBottom="5dp"
                android:text="−" android:textColor="@color/w_text" android:textStyle="bold" android:textSize="14sp" />
            <TextView
                android:id="@+id/w_coffee_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_accent"
                android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="5dp" android:paddingBottom="5dp"
                android:text="+1" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <LinearLayout
            android:id="@+id/w_focus_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_card"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fokus" android:textColor="@color/w_muted" android:textSize="11sp" />
            <TextView android:id="@+id/w_focus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 min" android:textColor="@color/w_text" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_screen_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_card"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Games/Videos" android:textColor="@color/w_muted" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/w_screen" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–" android:textColor="@color/w_text" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/w_brief_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_accent"
            android:gravity="center"
            android:padding="10dp"
            android:maxLines="1"
            android:text="Check-in"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_sleep_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_card"
            android:gravity="center"
            android:padding="10dp"
            android:maxLines="1"
            android:text="Gute Nacht"
            android:textColor="@color/w_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_habits_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:text="Gewohnheiten"
        android:textColor="@color/w_muted"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/w_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#FF2C3050"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alles erledigt. Stark."
        android:textColor="@color/w_good"
        android:textSize="13sp" />
</LinearLayout>
