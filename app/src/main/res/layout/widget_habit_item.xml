<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/h_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/h_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/w_text"
            android:textSize="15sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/h_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/w_muted"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/h_min"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/chip_off"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="6dp" android:paddingBottom="6dp"
        android:text="Mini"
        android:textColor="@color/w_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/h_full"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/chip_off"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="6dp" android:paddingBottom="6dp"
        android:text="Ganz"
        android:textColor="@color/w_text"
        android:textSize="13sp" />
</LinearLayout>
